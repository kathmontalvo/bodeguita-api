# Copia este archivo como .env y cambia los valores. .env NO se sube al repo.

# Puerto de la API
PORT=3000

# Postgres (docker-compose usa estas mismas variables para crear la base)
DB_HOST=localhost
# Si ya tienes un Postgres local usando el 5432, cambia a otro (ej. 5433).
DB_PORT=5432
DB_USER=bodeguita
DB_PASSWORD=cambia-esta-clave
DB_NAME=bodeguita

# Opcional: base que usan los e2e (se crea sola). Por defecto: bodeguita_test
# DB_NAME_TEST=bodeguita_test
